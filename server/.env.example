# MongoDB Atlas: Database > Connect > Drivers > copy the connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/prop1000?retryWrites=true&w=majority
# Long random string used to sign admin login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
# Set to production when deployed (turns on secure cookies)
NODE_ENV=development
